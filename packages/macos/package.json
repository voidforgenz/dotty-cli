{
  "name": "@dottyfiles/macos",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidforgenz/dotty-cli",
    "directory": "packages/macos"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@dottyfiles/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "macos",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/macos/dist",
          "main": "packages/macos/src/index.ts",
          "tsConfig": "packages/macos/tsconfig.lib.json",
          "format": [
            "esm"
          ],
          "declarationRootDir": "packages/macos/src"
        }
      }
    }
  },
  "dependencies": {
    "@dottyfiles/core": "workspace:*",
    "@dottyfiles/config": "workspace:*"
  }
}
