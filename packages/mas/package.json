{
  "name": "@dotty/mas",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@dotty/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "mas",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/mas/dist",
          "main": "packages/mas/src/index.ts",
          "tsConfig": "packages/mas/tsconfig.lib.json",
          "format": [
            "esm"
          ],
          "declarationRootDir": "packages/mas/src"
        }
      }
    }
  },
  "dependencies": {
    "@dotty/core": "workspace:*",
    "@dotty/config": "workspace:*",
    "@dotty/runtime": "workspace:*"
  }
}
